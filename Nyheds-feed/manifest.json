{
  "manifest_version": 3,
  "name": "Nyheds feed",
  "version": "3.5",
  "description": "Viser de seneste nyheder fra DR.dk.",
  "host_permissions": [
    "https://api.open-meteo.com/*"
  ],
  "optional_host_permissions": [
    "https://www.dr.dk/*"
  ],
  "icons":{
    "48":"Public/icons/icon-48.png"
  },
  "background": {
    "scripts": ["Background/background.js"],
    "type": "module"
  },
  "action": {
    "default_icon": "Public/icons/icon-48.png",
    "default_popup": "Public/popup/popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nyheds-feed@yourdomain.local"
    }
  }
}