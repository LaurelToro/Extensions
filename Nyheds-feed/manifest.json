{
  "manifest_version": 3,
  "name": "Nyheds feed",
  "version": "3.2",
  "description": "Viser de seneste nyheder fra DR.dk.",
  "host_permissions": [
    "https://www.dr.dk/*",
    "https://api.open-meteo.com/*"
  ],

    "action": {
    "default_icon": "icons/icon-48.png",
    "default_popup": "popup/popup.html"
    },
  "web_accessible_resources": [
    {
      "resources": ["logos/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "nyheds-feed@yourdomain.local"
    }
  }
}